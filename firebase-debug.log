[debug] [2026-05-25T01:05:45.825Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/chemlog-43c08/rulesets {"name":"projects/chemlog-43c08/rulesets/0dc047c4-ca0d-44df-bae5-0fd11bb3fe18","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Chemistry submissions\n    match /poolSubmissions/{docId} {\n      allow read, write: if true;\n    }\n\n    // Legacy\n    match /formSubmissions/{docId} {\n      allow read, write: if true;\n    }\n\n    // CSV export (optional)\n    match /chemistryLogs/{docId} {\n      allow read, write: if true;\n    }\n\n    // Pool definitions/rules\n    match /pools/{poolId} {\n      allow read, write: if true;\n    }\n\n    // App settings (includes settings/trainingSchedule, settings/employeePerformance, settings/setQuestionTypes)\n    match /settings/{docId} {\n      allow read, write: if true;\n    }\n\n    // Training signups\n    match /trainingSignups/{signupId} {\n      allow read, write: if true;\n    }\n\n    // Cleanliness report submissions\n    match /dutySubmissions/{submissionId} {\n      allow read, write: if true;\n    }\n\n    // Managerial report submissions\n    match /managerialReports/{submissionId} {\n      allow read, write: if true;\n    }\n\n    // Fill line, hose, and bleach feeder operational status updates\n    match /operationalStatusLogs/{logId} {\n      allow read, write: if true;\n    }\n\n    // Lifeguard employees who can log in via home screen\n    match /employees/{employeeId} {\n      allow read, write: if true;\n    }\n\n    // Lifeguard login accounts created from the home screen\n    match /lifeguardAccounts/{username} {\n      allow read, write: if true;\n    }\n\n    // Uploaded resources metadata\n    match /resourcesDocuments/{documentId} {\n      allow read, write: if true;\n    }\n\n    // Resource files stored as Firestore fallback chunks when Firebase Storage CORS blocks browser uploads\n    match /resourcesDocuments/{documentId}/fileChunks/{chunkId} {\n      allow read, write: if true;\n    }\n\n    // Signed user agreement acknowledgments\n    match /userAgreements/{agreementId} {\n      allow read, write: if true;\n    }\n\n    // Auditing form submissions\n    match /testingResults/{resultId} {\n      allow read, write: if true;\n    }\n\n    // Deny everything else\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-25T01:05:45.869983Z","metadata":{"services":["cloud.firestore"]}}
