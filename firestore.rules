rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Chemistry submissions
    match /poolSubmissions/{docId} {
      allow read, write: if true;
    }

    // Legacy
    match /formSubmissions/{docId} {
      allow read, write: if true;
    }

    // CSV export (optional)
    match /chemistryLogs/{docId} {
      allow read, write: if true;
    }

    // Pool definitions/rules
    match /pools/{poolId} {
      allow read, write: if true;
    }

    // App settings (includes settings/trainingSchedule, settings/employeePerformance, settings/setQuestionTypes)
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Training signups
    match /trainingSignups/{signupId} {
      allow read, write: if true;
    }

    // Cleanliness report submissions
    match /dutySubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Cleanliness report photos stored in Firestore chunks when browser Storage uploads are blocked
    match /dutySubmissionMedia/{submissionId}/photos/{photoId} {
      allow read, write: if true;
    }

    match /dutySubmissionMedia/{submissionId}/photos/{photoId}/chunks/{chunkId} {
      allow read, write: if true;
    }

    // Gate attendant DES logbook submissions and Firestore-backed photos
    match /desLogbookSubmissions/{submissionId} {
      allow read, write: if true;
    }

    match /desLogbookSubmissionMedia/{submissionId}/photos/{photoId} {
      allow read, write: if true;
    }

    match /desLogbookSubmissionMedia/{submissionId}/photos/{photoId}/chunks/{chunkId} {
      allow read, write: if true;
    }

    // Pool chemistry auto-controller photos stored in Firestore chunks
    match /chemSubmissionMedia/{submissionId}/photos/{photoId} {
      allow read, write: if true;
    }

    match /chemSubmissionMedia/{submissionId}/photos/{photoId}/chunks/{chunkId} {
      allow read, write: if true;
    }

    // Managerial report submissions
    match /managerialReports/{submissionId} {
      allow read, write: if true;
    }

    // DES pre-inspection submissions and Firestore-backed photos
    match /desPreInspections/{submissionId} {
      allow read, write: if true;
    }

    match /desPreInspectionMedia/{submissionId}/photos/{photoId} {
      allow read, write: if true;
    }

    match /desPreInspectionMedia/{submissionId}/photos/{photoId}/chunks/{chunkId} {
      allow read, write: if true;
    }

    // Fill line, hose, and bleach feeder operational status updates
    match /operationalStatusLogs/{logId} {
      allow read, write: if true;
    }

    // Weekly inventory and urgent supply needs submissions
    match /inventorySubmissions/{submissionId} {
      allow read, write: if true;
    }

    // Facility to-do list tasks and Firestore-backed proof photos
    match /facilityTasks/{taskId} {
      allow read, write: if true;
    }

    match /taskProofMedia/{taskId}/photos/{photoId} {
      allow read, write: if true;
    }

    match /taskProofMedia/{taskId}/photos/{photoId}/chunks/{chunkId} {
      allow read, write: if true;
    }

    // Lifeguard employees who can log in via home screen
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Lifeguard login accounts created from the home screen
    match /lifeguardAccounts/{username} {
      allow read, write: if true;
    }

    // Uploaded resources metadata
    match /resourcesDocuments/{documentId} {
      allow read, write: if true;
    }

    // Resource files stored as Firestore fallback chunks when Firebase Storage CORS blocks browser uploads
    match /resourcesDocuments/{documentId}/fileChunks/{chunkId} {
      allow read, write: if true;
    }

    // Typed E-Sign PDF acknowledgments for uploaded resources
    match /resourcesDocuments/{documentId}/eSignatures/{signatureId} {
      allow read, write: if true;
    }

    // Signed user agreement acknowledgments
    match /userAgreements/{agreementId} {
      allow read, write: if true;
    }

    // Auditing form submissions
    match /testingResults/{resultId} {
      allow read, write: if true;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
